# @name loginRequest
POST http://192.168.1.10/api/auth/login
Content-Type: application/json

{
    "email": "test@test.local",
    "password": "newpassword"
}

###
# CORRECCIÓN: Se elimina $.Data si el token viene en la raíz del JSON
@access_token = {{loginRequest.response.body.$.accessToken}}

###
POST http://192.168.1.10/api/auth/logout
#Authorization: Bearer {{access_token}}

###
POST http://192.168.1.10/api/auth/refresh
#Authorization: Bearer {{access_token}}

###
GET http://192.168.1.10/api/auth/me
Authorization: Bearer {{access_token}}

###
POST http://192.168.1.10/api/auth/change-password
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "current": "newpassword1",
    "password": "newpassword"
}