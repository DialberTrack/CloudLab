# =============================================================================
# AUTHENTICATION
# =============================================================================

### Login as admin
# @name loginRequest
POST http://192.168.1.10/api/auth/login
Content-Type: application/json

{
    "email": "admin@cloudlab.local",
    "password": "password123"
}
###
### Login as user
# @name loginRequest
POST http://192.168.1.10/api/auth/login
Content-Type: application/json

{
    "email": "test2@cloudlab.local",
    "password": "password123"
}

### ---------------------------------------------------------------------------
@access_token = {{loginRequest.response.body.$.accessToken}}

### ---------------------------------------------------------------------------
POST http://192.168.1.10/api/auth/logout

### ---------------------------------------------------------------------------
POST http://192.168.1.10/api/auth/refresh
Content-Type: application/json

### ---------------------------------------------------------------------------
GET http://192.168.1.10/api/auth/me
Authorization: Bearer {{access_token}}

# -----------------------------------------------------------------------------
# ADMIN USERS
# -----------------------------------------------------------------------------

### Change password
POST http://192.168.1.10/api/auth/change-password
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "current": "7ebc16a695d9",
    "password": "password123"
}

### List users
GET http://192.168.1.10/api/admin/users
Authorization: Bearer {{access_token}}

### Create user
POST http://192.168.1.10/api/admin/users
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "email": "test3@cloudlab.local",
    "name": "Test",
    "password": "password123"
}

### Get user
GET http://192.168.1.10/api/admin/users/e14bdacb-d1af-11f1-be50-f44d30e355a1
Authorization: Bearer {{access_token}}

### Update user
PATCH http://192.168.1.10/api/admin/users/8e0ff706-d17f-11f1-be50-f44d30e355a1
Content-Type: application/json
Authorization: Bearer {{access_token}}

{
    "role": "user"
}

### Delete user
DELETE http://192.168.1.10/api/admin/users/e14bdacb-d1af-11f1-be50-f44d30e355a1
Authorization: Bearer {{access_token}}

### Reset user password
POST http://192.168.1.10/api/admin/users/3e55acdc-d1b1-11f1-be50-f44d30e355a1/reset-password
Authorization: Bearer {{access_token}}

# -----------------------------------------------------------------------------
# CONTAINER IMAGES
# -----------------------------------------------------------------------------

### List container images
GET http://192.168.1.10/api/container-images/
Authorization: Bearer {{access_token}}

### Create container image
POST http://192.168.1.10/api/container-images/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "name": "Ubuntu",
    "image": "1"
}

### Get container image
GET http://192.168.1.10/api/container-images/d1999e8d-d1c8-11f1-be50-f44d30e355a1
Authorization: Bearer {{access_token}}

### Delete container image
DELETE http://192.168.1.10/api/container-images/c57801aa-d1cb-11f1-be50-f44d30e355a1
Authorization: Bearer {{access_token}}

### Update container image
PATCH http://192.168.1.10/api/container-images/16697629-4254-4fc2-bcce-4c88f4ecde2f
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "name": "Ubuntu 20.04"
}

# -----------------------------------------------------------------------------
# WORKSPACES
# -----------------------------------------------------------------------------

### List workspaces
GET http://192.168.1.10/api/workspaces/
Authorization: Bearer {{access_token}}

### List all workspaces
GET http://192.168.1.10/api/admin/workspaces/
Authorization: Bearer {{access_token}}

### Create workspace
POST http://192.168.1.10/api/workspaces/
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
    "name": "My Workspace",
    "container_image_id": "fa67a9d1-d1ba-11f1-be50-f44d30e355a1"
}